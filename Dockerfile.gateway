ARG PYTHON_BASE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${PYTHON_BASE}
WORKDIR /app
COPY requirements.txt /app/
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --index-url ${PIP_INDEX_URL} -r requirements.txt
COPY app.py /app/
COPY web/ /app/web/
ENV STATE_DIR=/state PORT=8088
EXPOSE 8088
CMD ["python", "-u", "app.py"]
